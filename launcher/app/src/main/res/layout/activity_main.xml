<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="44sp"
        android:fontFamily="@font/manrope"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="20dp">

        <!-- Top Bar: Clock + Controls HUD -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/manrope"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="46sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="6dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="6dp"
                        android:background="#33FFFFFF" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="7dp"
                        android:format12Hour="EEEE  d MMMM"
                        android:format24Hour="EEEE  d MMMM"
                        android:textColor="#A6FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/manrope"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.14"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Top Action Pills HUD -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnSearch"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:maxWidth="240dp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/btnSettings"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Category Filter Tabs -->
        <LinearLayout
            android:id="@+id/layoutCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tabAll"
                style="@style/TopButton"
                android:layout_marginStart="0dp"
                android:layout_height="32dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/tab_all"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabMedia"
                style="@style/TopButton"
                android:layout_height="32dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/tab_media"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabTools"
                style="@style/TopButton"
                android:layout_height="32dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/tab_tools"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Apps Grid wrapper -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="6dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- Continue watching, tvOS top-shelf style: sits right above the dock (placed in code), shown while
         the dock is parked and there is something to continue. -->
    <LinearLayout
        android:id="@+id/layoutWatchNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/lblWatchNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/continue_watching"
            android:textAllCaps="true"
            android:textColor="#7AFFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/manrope"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.18"
            android:layout_marginBottom="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listWatchNext"
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
