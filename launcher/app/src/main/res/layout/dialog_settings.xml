<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="20dp"
    android:elevation="24dp">

    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки VibeHome"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="-0.01" />

    <TextView
        android:id="@+id/bridgeInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Web Bridge: http://192.168.1.155:8989"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/settingsRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- RAM Cleaner -->
        <LinearLayout
            android:id="@+id/rowRamClean"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_ram"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/lblRamClean"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Очистить оперативную память (RAM)"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- Toggle Watch Next Shelf -->
        <LinearLayout
            android:id="@+id/rowToggleWatchNext"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_livetv"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/lblWatchNextToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Полка «Продолжить просмотр»: Вкл"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- Unhide All Apps -->
        <LinearLayout
            android:id="@+id/rowUnhideAll"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_hide"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/lblUnhideAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Восстановить скрытые приложения"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- Reset Dock to Defaults -->
        <LinearLayout
            android:id="@+id/rowResetDock"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_move"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Сбросить порядок в Dock"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- Android System Settings -->
        <LinearLayout
            android:id="@+id/rowSystemSettings"
            style="@style/TopButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Системные настройки Android"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
