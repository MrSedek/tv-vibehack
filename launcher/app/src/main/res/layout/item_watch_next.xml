<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="190dp"
        android:layout_height="105dp"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <!-- Ambient Backdrop gradient -->
        <View
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1A1A22" />

        <!-- Source badge (e.g., SmartTube, Kinopoisk) -->
        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/pill_bg"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:textAllCaps="true" />

        <!-- Play overlay indicator -->
        <ImageView
            android:id="@+id/playIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_livetv"
            android:tint="#80FFFFFF"
            android:contentDescription="@null" />

        <!-- Video title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <!-- Progress bar line at the bottom -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="50"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="#0A84FF" />
    </FrameLayout>
</FrameLayout>
